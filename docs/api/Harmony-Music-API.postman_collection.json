    {
      "name": "Piped API (fallback for streaming)",
      "description": "Endpoints alternativos de Piped API (instancias comunitarias). Usado para streams/downloads cuando YouTube Music no responde. Ver: https://github.com/TeamPiped/Piped-API\n\nConfigurar la variable `piped_base_url` apuntando a una instancia activa (ej. `https://pipedapi.kavin.rocks`).",
      "variable": [
        {"key": "piped_base_url", "value": "https://pipedapi.kavin.rocks", "type": "string"}
      ],
      "item": [
        {
          "name": "piped - search",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{piped_base_url}}/search?q=__QUERY__&filter=music_songs",
              "host": ["{{piped_base_url}}"],
              "path": ["search"],
              "query": [
                {"key": "q", "value": "__QUERY__"},
                {"key": "filter", "value": "music_songs"}
              ]
            }
          }
        },
        {
          "name": "piped - streams",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{piped_base_url}}/streams/__VIDEO_ID__",
              "host": ["{{piped_base_url}}"],
              "path": ["streams", "__VIDEO_ID__"]
            }
          }
        }
      ]
    }
