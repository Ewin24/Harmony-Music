        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"context\": {\n    \"client\": {\n      \"clientName\": \"WEB_REMIX\",\n      \"clientVersion\": \"1.20260623.01.00\",\n      \"hl\": \"en\"\n    },\n    \"user\": {}\n  },\n  \"input\": \"__QUERY__\"\n}"
        },
        "url": {
          "raw": "{{base_url}}music/get_search_suggestions?prettyPrint=false&alt=json&key=AIzaSyC9XL3ZjWddXya6X74dJoCTL-WEYFDNX30",
          "host": ["{{base_url}}music/get_search_suggestions"],
          "query": [
            {"key": "prettyPrint", "value": "false"},
